# Production environment for conference.intelligentso.com
DJANGO_SECRET_KEY="change-me-to-a-long-random-string"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=conference.intelligentso.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://conference.intelligentso.com
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Public base URL encoded into QR codes / share links
SITE_BASE_URL=https://conference.intelligentso.com

# Database: leave DB_ENGINE unset to use SQLite (recommended for this app)
